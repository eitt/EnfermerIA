# EnfermerIA analysis pipeline -------------------------------------------------
# Run from the project root: source("00_run_pipeline.R")
required_packages <- c(
"readxl", "openxlsx", "dplyr", "tidyr", "purrr", "stringr", "forcats",
"ggplot2", "scales", "patchwork", "psych", "lavaan", "semTools",
"GPArotation", "corrplot", "rlang", "tibble"
)
installed <- rownames(installed.packages())
missing <- setdiff(required_packages, installed)
if (length(missing) > 0) {
message("Installing missing packages: ", paste(missing, collapse = ", "))
install.packages(missing, dependencies = TRUE)
}
invisible(lapply(required_packages, library, character.only = TRUE))
options(
repos = c(CRAN = "https://cloud.r-project.org"),
pkgType = "binary",
timeout = 600
)
# Remove incomplete installation locks, if present
lock_dirs <- list.files(
.libPaths()[1],
pattern = "^00LOCK",
full.names = TRUE
)
if (length(lock_dirs) > 0) {
unlink(lock_dirs, recursive = TRUE, force = TRUE)
}
# Install the failed dependency first
install.packages(
"stringi",
dependencies = TRUE,
type = "binary"
)
# Verify that stringi can be loaded
stopifnot(requireNamespace("stringi", quietly = TRUE))
# Reinstall openxlsx after stringi is available
install.packages(
"openxlsx",
dependencies = TRUE,
type = "binary"
)
# Verify both packages
library(stringi)
library(openxlsx)
# EnfermerIA analysis pipeline -------------------------------------------------
# Run from the project root: source("00_run_pipeline.R")
# ============================================================
# PACKAGE INSTALLATION AND LOADING
# ============================================================
options(
repos = c(CRAN = "https://cloud.r-project.org"),
timeout = 600
)
required_packages <- c(
"readxl",
"openxlsx",
"dplyr",
"tidyr",
"purrr",
"stringr",
"forcats",
"tibble",
"ggplot2",
"scales",
"psych",
"lavaan",
"semTools",
"GPArotation",
"corrplot",
"naniar",
"janitor"
)
# Dependencies that commonly cause installation failures on Windows
priority_dependencies <- c(
"stringi",
"Rcpp",
"zip"
)
install_one_package <- function(package_name) {
if (requireNamespace(package_name, quietly = TRUE)) {
message("Package already available: ", package_name)
return(invisible(TRUE))
}
message("Installing package: ", package_name)
tryCatch(
{
install.packages(
package_name,
dependencies = TRUE,
type = if (.Platform$OS.type == "windows") "binary" else "source"
)
},
error = function(e) {
stop(
"Installation failed for package '",
package_name,
"'. Original error: ",
conditionMessage(e),
call. = FALSE
)
}
)
if (!requireNamespace(package_name, quietly = TRUE)) {
stop(
"Package '",
package_name,
"' remains unavailable after installation.",
call. = FALSE
)
}
invisible(TRUE)
}
# Remove incomplete package-installation locks
remove_package_locks <- function() {
for (library_path in .libPaths()) {
if (!dir.exists(library_path)) {
next
}
lock_dirs <- list.files(
library_path,
pattern = "^00LOCK",
full.names = TRUE
)
if (length(lock_dirs) > 0) {
message(
"Removing incomplete installation locks from: ",
library_path
)
unlink(
lock_dirs,
recursive = TRUE,
force = TRUE
)
}
}
invisible(TRUE)
}
remove_package_locks()
# Install critical dependencies before the main packages
invisible(
lapply(
priority_dependencies,
install_one_package
)
)
# Install all remaining packages
invisible(
lapply(
required_packages,
install_one_package
)
)
# Load packages only after every installation has been verified
load_one_package <- function(package_name) {
tryCatch(
{
suppressPackageStartupMessages(
library(
package_name,
character.only = TRUE
)
)
},
error = function(e) {
stop(
"Package '",
package_name,
"' is installed but could not be loaded. ",
"Original error: ",
conditionMessage(e),
call. = FALSE
)
}
)
invisible(TRUE)
}
invisible(
lapply(
required_packages,
load_one_package
)
)
message("All required R packages were installed and loaded successfully.")
scripts <- c(
"R/00_config.R",
"R/01_utils.R",
"R/02_import_clean.R",
"R/03_descriptive.R",
"R/04_psychometrics.R",
"R/05_cfa.R",
"R/06_bivariate_quadrants.R"
)
for (script in scripts) {
message("Running ", script)
source(script, encoding = "UTF-8")
}
